# ==============================================================================
# SEO VA PRACTICE LAB — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# ==============================================================================

# Execution Mode
# Set to 'practice' to use static local datasets (default, no keys required)
# Set to 'live' to run active searches against third-party scraping APIs
NEXT_PUBLIC_APP_MODE=practice

# Targetron API (Recommended Live Data Provider)
NEXT_PUBLIC_TARGETRON_API_KEY=your_targetron_api_key_here

# Outscraper API (Community BYOK Data Provider)
NEXT_PUBLIC_OUTSCRAPER_API_KEY=your_outscraper_api_key_here

# Vercel Web Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
